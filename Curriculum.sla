        <PAGEOBJECT XPOS="128.347086614173" YPOS="195.749291338583" OwnPage="0" ItemID="88806192" PTYPE="4" WIDTH="425.196850393701" HEIGHT="70.8661417322835" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L425.197 0 L425.197 70.8661 L0 70.8661 L0 0 Z" copath="M0 0 L425.197 0 L425.197 70.8661 L0 70.8661 L0 0 Z" ImageRes="0" gXpos="128.347086614173" gYpos="195.749291338584" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle FONT="Public Sans Italic" FONTSIZE="9"/>
                <ITEXT FONT="Public Sans Regular" FONTSIZE="9" FCOLOR="Text-Base-Dark" CH="I am currently a student in the Master of Computer Systems program at the University of Santiago de Cali. My expected graduation date is July 20, 2026."/>
                <para LINESP="11"/>
                <para LINESP="11"/>
                <ITEXT FONT="Public Sans Regular" FONTSIZE="9" FCOLOR="Text-Base-Dark" CH="My research focus is on the development of automated systems for small and medium-sized enterprises (SMEs). My goal is to apply my knowledge and skills to develop systems that automate manual processes and integrate with existing processes within the company."/>
                <trail LINESP="11"/>
            </StoryText>
        </PAGEOBJECT>
