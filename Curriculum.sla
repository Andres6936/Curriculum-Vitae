                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="13" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of hexa­dec­i­mal ed­i­tor for any type of file. (Im­ple­mented in Qt Core)."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="13" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of Web ap­pli­ca­tion fo­cused on cell phones."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="13" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of two-di­men­sional graph­ics en­gine, us­ing OpenGL and SDL."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="13" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of frame­work for the de­sign, im­ple­men­ta­tion and de­vel­op­ment of pro­grams with ren­der­ing re­quire­ments and use of al­go­rithms (En­cryp­tion, Com­pres­sion, Pathfind­ing, etc ...)."/>
                <trail LINESPMode="0"/>
            </StoryText>
        </PAGEOBJECT>
