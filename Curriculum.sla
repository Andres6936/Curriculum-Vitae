            <StoryText>
                <DefaultStyle ALIGN="0" LINESPMode="1" FONT="Public Sans Medium" FONTSIZE="12"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of PNG im­age de­coder and en­coder ac­cord­ing to the spec­i­fi­ca­tions (PNG Stan­dard v1.2)."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of de­coder and en­coder based on Huff­man"/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="Cod­ing al­go­rithm for data bi­na­riza­tion and en­cryp­tion."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of soft­ware for con­ver­sion of PO files to XML."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of data­base (CRUD op­er­a­tions sup­port) for work­ing on CVS files."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of A* al­go­rithm (Pathfind­ing)."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of hexa­dec­i­mal ed­i­tor for any type of file. (Im­ple­mented in Qt Core)."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of Web ap­pli­ca­tion fo­cused on cell phones."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of two-di­men­sional graph­ics en­gine, us­ing OpenGL and SDL."/>
                <para LINESPMode="0"/>
                <para LINESPMode="0"/>
                <ITEXT FONT="Merriweather Regular" FONTSIZE="11" FCOLOR="Text-Base-Dark" SCALEV="100" CH="De­vel­op­ment and im­ple­men­ta­tion of frame­work for the de­sign, im­ple­men­ta­tion and de­vel­op­ment of pro­grams with ren­der­ing re­quire­ments and use of al­go­rithms (En­cryp­tion, Com­pres­sion, Pathfind­ing, etc ...)."/>
                <trail LINESPMode="0"/>
            </StoryText>
        </PAGEOBJECT>
